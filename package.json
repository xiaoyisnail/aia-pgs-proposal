{
  "name": "aia-pgs-proposal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "onboard": "node scripts/onboard.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "setup:chrome": "playwright install chrome",
    "setup:outlook": "node scripts/login-agency.mjs --setup-outlook",
    "login": "node scripts/login-agency.mjs",
    "login:fresh": "node scripts/login-agency.mjs --fresh-login",
    "params:check": "node scripts/generate-proposal.mjs --check-params",
    "products:list": "node scripts/generate-proposal.mjs --list-products",
    "product:inspect": "node scripts/generate-proposal.mjs --inspect-product",
    "generate": "node scripts/generate-proposal.mjs",
    "generate:fresh": "node scripts/generate-proposal.mjs --fresh-login",
    "test": "node --test",
    "check": "node --check scripts/runtime-platform.mjs && node --check scripts/credentials.mjs && node --check scripts/onboard.mjs && node --check scripts/setup.mjs && node --check scripts/login-agency.mjs && node --check scripts/generate-proposal.mjs"
  },
  "dependencies": {
    "playwright": "1.62.0"
  }
}
